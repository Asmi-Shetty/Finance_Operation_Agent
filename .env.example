APP_ENV=development
APP_NAME=AI Finance Operations Agent
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://finance:finance@postgres:5432/finance_agent
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=10485760
EXTRACTION_CONFIDENCE_THRESHOLD=0.85
PO_VARIANCE_TOLERANCE=0.05
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
CORS_ORIGINS=http://localhost:5173

